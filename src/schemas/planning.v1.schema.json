{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanningAgentOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "tasks",
    "execution_order",
    "risks",
    "reasoning"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "goal": { "type": "string" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "priority",
          "dependencies",
          "acceptance_criteria"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "execution_order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence", "assumptions", "risks", "alternatives"],
      "properties": {
        "summary": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "alternatives": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
